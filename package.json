{
  "name": "databricks-sql-quickcheck",
  "displayName": "Quickcheck for Databricks SQL",
  "description": "A Databricks SQL language mode whose highlighting understands backslash escapes, raw strings and notebook cells, plus instant, as-you-type structural syntax checks: brackets, quotes, commas, operators, CASE/END.",
  "version": "0.4.0",
  "publisher": "ThomasAndrewSlater",
  "icon": "images/icon.png",
  "pricing": "Free",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/taslater/databricks-sql-quickcheck"
  },
  "bugs": {
    "url": "https://github.com/taslater/databricks-sql-quickcheck/issues"
  },
  "homepage": "https://github.com/taslater/databricks-sql-quickcheck#readme",
  "private": true,
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=22"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "databricks",
    "sql",
    "databricks sql",
    "spark sql",
    "spark",
    "notebook",
    "syntax highlighting",
    "lint",
    "linter",
    "syntax check",
    "delta lake",
    "unity catalog",
    "lakeflow"
  ],
  "main": "./out/extension.js",
  "types": "./out/index.d.ts",
  "exports": {
    ".": "./out/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dbsql-quickcheck": "./out/cli.js"
  },
  "activationEvents": [
    "onLanguage:sql",
    "onLanguage:databricks-sql"
  ],
  "contributes": {
    "languages": [
      {
        "id": "databricks-sql",
        "aliases": [
          "Databricks SQL",
          "databricks-sql",
          "dbsql"
        ],
        "extensions": [
          ".dbsql"
        ],
        "firstLine": "^\\uFEFF?-- Databricks notebook source",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "databricks-sql",
        "scopeName": "source.databricks-sql",
        "path": "./syntaxes/databricks-sql.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.python": "python",
          "meta.embedded.block.yaml": "yaml"
        }
      }
    ],
    "configuration": {
      "title": "Databricks SQL Quickcheck",
      "properties": {
        "databricksSqlQuickcheck.enable": {
          "type": "boolean",
          "default": true,
          "description": "Check SQL files as you type."
        },
        "databricksSqlQuickcheck.detectNotebooks": {
          "type": "boolean",
          "default": true,
          "description": "Open `.sql` files that begin with `-- Databricks notebook source` in the Databricks SQL language mode. Plain scripts stay as they are: associate them with `files.associations`, for example `{\"*.sql\": \"databricks-sql\"}` in a repository's .vscode/settings.json."
        },
        "databricksSqlQuickcheck.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "sql",
            "databricks-sql"
          ],
          "description": "Language ids to check."
        },
        "databricksSqlQuickcheck.warnings": {
          "type": "boolean",
          "default": true,
          "description": "Also report likely mistakes that Databricks may technically accept: a missing comma in a select list, a trailing comma before FROM, an unknown statement keyword."
        },
        "databricksSqlQuickcheck.explicitAliases": {
          "type": "boolean",
          "default": false,
          "description": "Warn on every implicit column alias (SELECT a b). Off by default because about one real file in ten aliases this way on purpose; turn it on if your team already requires AS, and every lost comma in a select list is reported."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test out/test/*.test.js",
    "keywords": "python3 scripts/gen_keywords.py ../sqlfluff",
    "package": "npm run build && mkdir -p dist && vsce package -o dist/databricks-sql-quickcheck.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
